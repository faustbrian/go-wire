        "package_selection": {
          "github.com/faustbrian/go-wire": "Use for shared format identifiers, stable error categories, and explicit JSON-or-XML detection.",
          "github.com/faustbrian/go-wire/bsonwire": "Use for bounded BSON document encoding and decoding with explicit duplicate-key and numeric policies.",
          "github.com/faustbrian/go-wire/cborwire": "Use for bounded CBOR processing with explicit deterministic profiles, tag policy, and structural limits.",
          "github.com/faustbrian/go-wire/jsonwire": "Use for bounded JSON encoding, decoding, and deterministic normalization with explicit strictness options.",
          "github.com/faustbrian/go-wire/msgpackwire": "Use for bounded MessagePack encoding and decoding with explicit map, extension, and numeric policies.",
          "github.com/faustbrian/go-wire/soap": "Use for bounded SOAP 1.1 and 1.2 envelope, body, and fault processing independent of HTTP policy.",
          "github.com/faustbrian/go-wire/tomlwire": "Use for bounded TOML document encoding and decoding with native datetime and strict-field options.",
          "github.com/faustbrian/go-wire/xmlwire": "Use for bounded XML document encoding and decoding with namespace, charset, and depth policy.",
          "github.com/faustbrian/go-wire/yamlwire": "Use for bounded YAML document encoding and decoding with explicit alias, merge, and duplicate-key policy."
